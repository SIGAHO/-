# Deny by default: code-only repository. Runtime data never belongs in Git.
/*
!/.gitignore
!/README.md
!/current/
/current/*
!/current/*.py
!/current/*.html
!/current/*.ps1
!/current/orchestrator.json
!/current/adapters/
/current/adapters/*
!/current/adapters/*.py
!/current/tests/
/current/tests/*
!/current/tests/*.py
!/docs/
**/__pycache__/
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.jsonl
**/*.sqlite*
**/*.gguf
**/*.safetensors
**/*.bin
